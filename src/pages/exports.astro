---
import banner from '../assets/images/hero-export.jpg';
import Button from '../components/ui/Button.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import PageBanner from '../components/ui/PageBanner.astro';
import ProcessFlow from '../components/ui/ProcessFlow.astro';
import RouteMap from '../components/ui/RouteMap.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';

// Draft copy. It describes capability and intent only: no countries, volumes, varieties or
// certificates are named until the client confirms them (IEC, APEDA, FSSAI, destinations).
const strengths: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'factory',
    title: 'Milled at Our Own Facility',
    text: 'Rice is processed by BBC Rice Industries, so quality is managed by us from paddy to packed bag.',
  },
  {
    icon: 'award',
    title: 'Consistent Quality',
    text: 'Careful cleaning, grading and sorting so each consignment matches what was agreed.',
  },
  {
    icon: 'users',
    title: 'Clear Communication',
    text: 'A direct point of contact from first enquiry to dispatch, with prompt and honest answers.',
  },
  {
    icon: 'trending-up',
    title: 'Long-Term Partnerships',
    text: 'We look to build lasting relationships with buyers, not one-time transactions.',
  },
];

const steps = [
  { title: 'Enquiry', text: 'Tell us the rice you need, the quantity and the destination.' },
  { title: 'Sample', text: 'We share details and samples for your evaluation.' },
  { title: 'Quotation', text: 'You receive a clear quotation for your requirement.' },
  { title: 'Agreement', text: 'Specifications, packing and terms are confirmed in writing.' },
  { title: 'Shipment', text: 'The consignment is processed, packed and dispatched.' },
];
---

<Layout
  title="Exports"
  description="From Indian farms to global markets: rice processed in India by BBC Rice Industries and supplied to buyers at home and abroad."
  overlayHeader
>
  <PageBanner
    title="From Indian Farms to Global Markets"
    text="Make in India. Export from India."
    image={banner}
    crumbs={[{ label: 'Exports' }]}
  />

  <section class="py-20 lg:py-28">
    <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading eyebrow="Our export business" title="Taking Indian Rice to the World" />
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink/80" data-stagger>
          <p class="font-semibold text-paddy-900">
            We take the strength of India's agricultural production to consumers and businesses across global
            markets, contributing to India's growing position in the international food and rice trade.
          </p>
          <p>
            India is one of the world's leading rice producers. As a rice miller, BBC Rice Industries adds value to
            that produce here in India and supplies it to buyers who expect dependable quality.
          </p>
          <p>
            Whether you are an importer, distributor or trading house, we would be glad to discuss your
            requirement.
          </p>
        </div>
        <div class="mt-9" data-reveal>
          <Button href="/contact?interest=export">Send an Export Enquiry</Button>
        </div>
      </div>
      <div class="rounded bg-ivory p-8 sm:p-12" data-reveal="right">
        <RouteMap tone="light" class="mx-auto max-w-md" />
      </div>
    </div>
  </section>

  <section class="bg-ivory py-20 lg:py-28">
    <div class="container-site">
      <SectionHeading eyebrow="Why source from us" title="A Dependable Supply Partner" align="center" />
      <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          strengths.map((item) => (
            <li class="group/item rounded border border-paddy-900/10 bg-white p-8 transition-[translate,box-shadow,border-color] duration-500 ease-brand hover:-translate-y-1.5 hover:border-gold-500 hover:shadow-xl">
              <Icon name={item.icon} class="size-9 text-gold-600" />
              <h3 class="mt-6 text-lg font-semibold text-paddy-900">{item.title}</h3>
              <span class="mt-3 block h-0.5 w-10 bg-gold-500 transition-[width] duration-500 ease-brand group-hover/item:w-20" />
              <p class="mt-4 leading-relaxed text-ink/70">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-paddy-900 py-20 text-white lg:py-28">
    <div class="container-site">
      <SectionHeading eyebrow="How we work" title="From Enquiry to Shipment" tone="dark" />
      <div class="mt-14">
        <ProcessFlow steps={steps} />
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container-site grid gap-10 rounded border-t-2 border-gold-500 bg-ivory p-8 sm:p-12 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div data-reveal>
        <h2 class="text-3xl font-semibold tracking-tight text-paddy-900">Export Enquiries</h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink/75">
          Share your requirement and our team will get back to you with details.
        </p>
        <div class="mt-8">
          <Button href="/contact?interest=export" variant="dark">Send an Export Enquiry</Button>
        </div>
      </div>
      <ul class="space-y-4" data-stagger>
        <li class="text-lg font-semibold text-paddy-900">{site.contact.person}</li>
        <li>
          <a href={site.contact.phoneHref} class="flex items-center gap-3 hover:text-gold-600">
            <Icon name="phone" class="size-5 text-gold-600" />
            {site.contact.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.contact.email}`} class="flex items-center gap-3 break-all hover:text-gold-600">
            <Icon name="mail" class="size-5 shrink-0 text-gold-600" />
            {site.contact.email}
          </a>
        </li>
      </ul>
    </div>
  </section>
</Layout>
