---
import banner from '../assets/images/biz-agriculture.jpg';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import PageBanner from '../components/ui/PageBanner.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';

const { contact } = site;
---

<Layout
  title="Contact Us"
  description={`Contact BBC Group India. Call ${contact.phoneDisplay} or email ${contact.email}.`}
  overlayHeader
>
  <PageBanner
    title="Contact Us"
    text="We would like to hear from you."
    image={banner}
    crumbs={[{ label: 'Contact Us' }]}
  />

  <section class="py-20 lg:py-28">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
      <div>
        <SectionHeading eyebrow="Get in touch" title="Talk to Us" />
        <p class="mt-6 text-lg leading-relaxed text-ink/75" data-reveal>
          Whether you are a buyer, supplier, farmer or partner, reach us by phone or email and we will get back to
          you.
        </p>

        <ul class="mt-10 space-y-6" data-stagger>
          <li class="flex gap-5">
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-ivory text-gold-600">
              <Icon name="users" />
            </span>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">Contact person</p>
              <p class="mt-1 text-lg font-semibold text-paddy-900">{contact.person}</p>
            </div>
          </li>
          <li class="flex gap-5">
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-ivory text-gold-600">
              <Icon name="phone" />
            </span>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">Phone</p>
              <a href={contact.phoneHref} class="link-draw mt-1 inline-block text-lg font-semibold text-paddy-900">
                {contact.phoneDisplay}
              </a>
            </div>
          </li>
          <li class="flex gap-5">
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-ivory text-gold-600">
              <Icon name="mail" />
            </span>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">Email</p>
              <a
                href={`mailto:${contact.email}`}
                class="link-draw mt-1 inline-block break-all text-lg font-semibold text-paddy-900"
              >
                {contact.email}
              </a>
            </div>
          </li>
          <li class="flex gap-5">
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-ivory text-gold-600">
              <Icon name="map-pin" />
            </span>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest text-gold-600">Address</p>
              <p class="mt-1 text-lg font-semibold text-paddy-900">BBC Rice Industries Private Limited</p>
              <p class="text-ink/75">{contact.address}</p>
              <a
                href={contact.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex items-center gap-2 text-sm font-semibold text-gold-600 hover:text-paddy-900"
              >
                View on Google Maps
                <Icon name="arrow-right" class="size-4" />
              </a>
            </div>
          </li>
        </ul>
      </div>

      {/* The enquiry form (Task 6) replaces this card */}
      <div id="enquiry" class="self-start rounded border-t-2 border-gold-500 bg-ivory p-8 sm:p-12" data-reveal="right">
        <h2 class="text-2xl font-semibold text-paddy-900">Send an Enquiry</h2>
        <p class="mt-3 text-lg leading-relaxed text-ink/75">
          Tell us what you need and which business it relates to. Email or call us directly.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href={`mailto:${contact.email}?subject=Website enquiry`} variant="dark">Email Us</Button>
          <Button href={contact.phoneHref} variant="outline" arrow={false}>Call {contact.phoneDisplay}</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ivory">
    <iframe
      src={contact.mapEmbedUrl}
      title="Map showing BBC Rice Industries Private Limited"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="block h-[460px] w-full border-0"
      data-lenis-prevent></iframe>
  </section>
</Layout>
