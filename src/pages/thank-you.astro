---
import Button from '../components/ui/Button.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You" description="Your enquiry has been sent.">
  <section class="py-24 lg:py-36">
    <div class="container-site max-w-2xl text-center">
      <p class="text-xs tracking-[0.5em] text-gold-600" aria-hidden="true">★★★★★</p>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-paddy-900 sm:text-5xl" data-reveal>Thank You</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink/75" data-reveal data-reveal-delay="0.1">
        Your details have been sent. We will get back to you soon.
      </p>
      <div class="mt-9" data-reveal data-reveal-delay="0.2">
        <Button href="/" variant="dark">Back to Home</Button>
      </div>
    </div>
  </section>
</Layout>
