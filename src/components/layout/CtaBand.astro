---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<section class="bg-gold-500 text-paddy-900">
  <div class="container-site flex flex-wrap items-center justify-between gap-8 py-14 lg:py-16">
    <div class="max-w-2xl" data-reveal>
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Let's Talk Business.</h2>
      <p class="mt-3 text-lg text-paddy-900/85">
        Whether you are a buyer, supplier, farmer or partner, we would like to hear from you.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-4" data-reveal data-reveal-delay="0.1">
      <Button href="/contact" variant="dark">Send an Enquiry</Button>
      <a
        href={site.contact.phoneHref}
        class="inline-flex items-center gap-2 rounded border border-paddy-900 px-6 py-3 text-sm font-semibold transition-colors duration-300 hover:bg-paddy-900 hover:text-white"
      >
        <Icon name="phone" class="size-4" />
        {site.contact.phoneDisplay}
      </a>
    </div>
  </div>
</section>
