---
import { site } from '../../data/site';
import Icon from '../ui/Icon.astro';
---

<div class="fixed bottom-5 right-5 z-40 flex flex-col gap-3 md:hidden">
  {
    site.contact.whatsappEnabled && (
      <a
        href={site.contact.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="grid size-13 place-items-center rounded-full bg-paddy-500 text-white shadow-lg"
        aria-label="Chat on WhatsApp"
      >
        <Icon name="chat" class="size-6" />
      </a>
    )
  }
  <a
    href={site.contact.phoneHref}
    class="grid size-13 place-items-center rounded-full bg-gold-500 text-paddy-900 shadow-lg"
    aria-label={`Call ${site.contact.phoneDisplay}`}
  >
    <Icon name="phone" class="size-6" />
  </a>
</div>
