---
import { Image } from 'astro:assets';
import type { Business } from '../../data/businesses';
import Icon from './Icon.astro';

interface Props {
  business: Business;
  /** Small label over the photo, e.g. "01" */
  label?: string;
}

const { business, label } = Astro.props;
---

<a href={`/businesses/${business.slug}`} class="group/card block">
  <div class="relative aspect-[4/3] overflow-hidden rounded">
    <Image
      src={business.image}
      alt=""
      widths={[400, 640, 800]}
      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
      class="size-full object-cover transition-transform duration-[900ms] ease-brand group-hover/card:scale-108"
    />
    <div class="absolute inset-0 bg-linear-to-t from-paddy-900/70 via-transparent to-transparent"></div>
    {label && <span class="absolute bottom-4 left-5 font-serif text-4xl font-semibold text-white/90">{label}</span>}
  </div>
  <h3 class="mt-5 text-xl font-semibold text-paddy-900">{business.title}</h3>
  <p class="mt-2 leading-relaxed text-ink/70">{business.summary}</p>
  <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-gold-600">
    <span class="link-draw group-hover/card:bg-[length:100%_1.5px]">{business.cta}</span>
    <Icon name="arrow-right" class="size-4 transition-transform duration-300 ease-brand group-hover/card:translate-x-1" />
  </span>
</a>
