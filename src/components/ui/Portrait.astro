---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  photo?: ImageMetadata;
  name: string;
  class?: string;
}

const { photo, name, class: className = '' } = Astro.props;
---

{
  photo ? (
    <Image
      src={photo}
      alt={name}
      widths={[320, 480, 640]}
      sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
      class:list={['size-full object-cover object-top', className]}
    />
  ) : (
    // Neutral silhouette used until a real portrait is supplied
    <svg viewBox="0 0 400 500" class:list={['size-full', className]} role="img" aria-label="Portrait to follow">
      <defs>
        <linearGradient id="portrait-bg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#efe7d3" />
          <stop offset="1" stop-color="#d9cba6" />
        </linearGradient>
      </defs>
      <rect width="400" height="500" fill="url(#portrait-bg)" />
      <circle cx="200" cy="190" r="78" fill="#12301c" opacity="0.22" />
      <path d="M40 500c0-110 68-190 160-190s160 80 160 190z" fill="#12301c" opacity="0.22" />
    </svg>
  )
}
