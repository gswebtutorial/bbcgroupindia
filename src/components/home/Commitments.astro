---
import { commitments } from '../../data/home';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="py-20 lg:py-28">
  <div class="container-site">
    <div class="grid gap-6 lg:grid-cols-2 lg:gap-20">
      <SectionHeading eyebrow="Our commitments" title="Aligned with India's Growth Priorities" />
      <p class="self-end text-lg leading-relaxed text-ink/75" data-reveal data-reveal-delay="0.1">
        Our work is guided by the same priorities that are shaping India's economy — manufacturing in India, growing
        responsibly, strengthening agriculture and taking Indian produce to the world.
      </p>
    </div>

    <ol class="mt-14 grid gap-px overflow-hidden rounded bg-paddy-900/10 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {
        commitments.map((item, i) => (
          <li class="group/commit relative flex flex-col bg-white p-8 transition-colors duration-500 hover:bg-paddy-900 hover:text-white">
            <div class="flex items-start justify-between">
              <span class="grid size-14 place-items-center rounded-full bg-ivory text-gold-600 transition-colors duration-500 group-hover/commit:bg-gold-500 group-hover/commit:text-paddy-900">
                <Icon name={item.icon} class="size-7" />
              </span>
              <span class="font-serif text-4xl font-semibold text-paddy-900/15 transition-colors duration-500 group-hover/commit:text-white/20">
                0{i + 1}
              </span>
            </div>
            <h3 class="mt-8 text-xl font-semibold leading-snug text-paddy-900 transition-colors duration-500 group-hover/commit:text-white">
              {item.title}
            </h3>
            <p class="mt-3 leading-relaxed text-ink/70 transition-colors duration-500 group-hover/commit:text-white/80">
              {item.text}
            </p>
            {item.href && (
              <a
                href={item.href}
                class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-gold-600 after:absolute after:inset-0 group-hover/commit:text-gold-300"
              >
                Learn more
                <Icon name="arrow-right" class="size-4" />
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
