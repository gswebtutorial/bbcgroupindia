---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo.png';
import { reasons } from '../../data/home';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="relative overflow-hidden bg-ivory py-20 lg:py-28">
  <Image
    src={logo}
    alt=""
    width={560}
    height={560}
    class="pointer-events-none absolute -left-40 -top-24 size-[560px] opacity-[0.07]"
  />
  <div class="container-site relative">
    <SectionHeading eyebrow="Our strengths" title="Why BBC Group India?" align="center" />

    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {
        reasons.map((reason) => (
          <li class="group/reason rounded border border-paddy-900/10 bg-white p-8 transition-[translate,box-shadow,border-color] duration-500 ease-brand hover:-translate-y-1.5 hover:border-gold-500 hover:shadow-xl">
            <Icon name={reason.icon} class="size-9 text-gold-600" />
            <h3 class="mt-6 text-lg font-semibold text-paddy-900">{reason.title}</h3>
            <span class="mt-3 block h-0.5 w-10 bg-gold-500 transition-[width] duration-500 ease-brand group-hover/reason:w-20" />
            <p class="mt-4 leading-relaxed text-ink/70">{reason.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
