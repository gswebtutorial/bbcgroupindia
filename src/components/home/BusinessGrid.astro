---
import { businesses } from '../../data/businesses';
import BusinessCard from '../ui/BusinessCard.astro';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="py-20 lg:py-28">
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading eyebrow="What we do" title="Our Businesses" />
      <div data-reveal>
        <Button href="/businesses" variant="outline">View All Businesses</Button>
      </div>
    </div>

    <ul class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {
        businesses.map((business, i) => (
          <li>
            <BusinessCard business={business} label={`0${i + 1}`} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
